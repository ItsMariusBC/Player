{
  "name": "player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate:music": "node music/generate.mjs",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "bun test ./tests/unit --reporter=junit --reporter-outfile=reports/unit.xml",
    "test:e2e": "playwright test",
    "validate": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "cva": "npm:class-variance-authority@^0.7.0",
    "framer-motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "music-metadata": "12.3.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22"
}
