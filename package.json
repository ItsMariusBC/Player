{
  "name": "player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api,oidc \"vite\" \"yarn dev:server\" \"yarn dev:oidc\"",
    "dev:server": "node --env-file=.env.development --no-warnings=ExperimentalWarning --watch server/src/main.ts",
    "dev:oidc": "node --watch server/dev/mock-oidc.ts",
    "build": "vite build && yarn build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "migrate:catalog": "node --no-warnings=ExperimentalWarning server/src/migrate-catalog.ts",
    "start": "node --no-warnings=ExperimentalWarning dist/server/main.js",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit --incremental false && tsc --noEmit -p server/tsconfig.json",
    "test": "bun test ./tests/unit --reporter=junit --reporter-outfile=reports/unit.xml",
    "test:server": "node --no-warnings=ExperimentalWarning --test \"server/test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "validate": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn test:server && yarn build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@hono/node-server": "2.1.5",
    "@react-three/fiber": "9.8.2",
    "busboy": "1.6.0",
    "cva": "npm:class-variance-authority@^0.7.0",
    "framer-motion": "14.6.0",
    "hono": "4.13.14",
    "metaflac-js": "1.1.0",
    "music-metadata": "12.3.2",
    "node-id3": "0.2.9",
    "openid-client": "6.8.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.4",
    "@types/busboy": "1.5.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.1",
    "oidc-provider": "9.13.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": {
    "node": ">=24 <25",
    "yarn": "1.22.22"
  },
  "packageManager": "yarn@1.22.22"
}
