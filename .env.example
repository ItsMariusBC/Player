# Public origin of the app, used for OIDC redirects (required, https in production).
# Redirect URL to register in Authentik: ${APP_URL}/api/auth/callback
APP_URL=

# Listening port.
# PORT=8080

# Data directory (SQLite database and media).
# DATA_DIR=/data

# Authentik application URL, e.g. https://auth.example/application/o/<slug>/ (required).
OIDC_ISSUER=

# Provider credentials (required).
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Name of the groups claim.
# OIDC_GROUPS_CLAIM=groups

# Group names granting access.
# OIDC_GROUP_ADMIN=admin
# OIDC_GROUP_USERS=users

# 32 bytes as 64 hex characters or 44 base64 characters (required).
# Encrypts tokens at rest and signs the temporary cookie. Generate: openssl rand -hex 32
SESSION_SECRET=

# Absolute session lifetime in hours.
# SESSION_TTL_HOURS=12

# Maximum size of an imported file, in MB.
# MAX_UPLOAD_MB=200

# Reserved for a later use (client IP for rate limiting); no effect today.
# URLs and the cookie Secure flag come from APP_URL; X-Forwarded-* is never read.
# TRUST_PROXY=false

# Dev-only login bypass (admin / user buttons, no OIDC). Leave empty or false.
# The server refuses to start with DEV_BYPASS_LOGIN=true when NODE_ENV=production.
# DEV_BYPASS_LOGIN=false

# development | production | test
# NODE_ENV=production
